<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flatheadmill.postcard.renewer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/johndoe/.local/bin/postcard</string>
        <string>renewer</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/johndoe/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/johndoe</string>
    </dict>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/johndoe/Library/Logs/postcard-renewer.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/johndoe/Library/Logs/postcard-renewer.log</string>
</dict>
</plist>
