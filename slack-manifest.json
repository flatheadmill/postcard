{
  "display_information": {
    "name": "Postcard",
    "description": "Search, read, and send carded Slack messages as yourself."
  },
  "oauth_config": {
    "redirect_urls": [
      "http://localhost:8765/auth"
    ],
    "scopes": {
      "user": [
        "channels:history",
        "channels:read",
        "chat:write",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "search:read",
        "usergroups:read",
        "users:read"
      ]
    },
    "pkce_enabled": true
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
