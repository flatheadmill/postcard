# The caller owns account and fields; the root frame owns account_grant.
# Commands use the same
# saved-account selection and a single grant snapshot; login may create a
# new name and therefore has its own selection path.
typeset root=${XDG_CONFIG_HOME:-$HOME/.config}/postcard/accounts
typeset directory credentials grant metadata
typeset -a accounts=()
# A broken or expired grant still counts. An unfinished login directory has
# no credentials and must not make a saved account ambiguous.
for directory in $root/*(N/); do
    [[ -e $directory/credentials.json || -L $directory/credentials.json ]] &&
        accounts+=( ${directory:t} )
done
if [[ -v o_account ]]; then
    account=$o_account
    [[ $account =~ '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' ]] || { warn 'invalid account name'; return 1; }
    # Match the stored spelling even on a case-insensitive filesystem.
    (( ${accounts[(Ie)$account]} )) || { warn 'no saved account named %s' "$account"; return 1; }
else
    case ${#accounts} in
        (0) warn 'no saved accounts; run postcard --account NAME login --client-id ID'; return 1 ;;
        (1) account=$accounts[1] ;;
        (*) warn 'multiple saved accounts; select one with --account NAME'; return 1 ;;
    esac
fi
credentials=$root/$account/credentials.json
[[ ! -L ${credentials:h} && ! -L $credentials && -f $credentials ]] ||
    { warn 'invalid credential file for account %s' "$account"; return 1; }

# Open once. Atomic login replacement gives us a whole old or new grant;
# identity and token travel together. Reading never takes the login lock,
# writes credentials, or consumes the refresh token.
grant=$(postcard_grant_check < $credentials) || { warn 'invalid credentials for account %s' "$account"; return 1; }
metadata=$(print -rn -- "$grant" | jq -r '
    .client_id, .team_id, .user_id, .access_token, (.expires_at // 0), .scope,
    (if .renewal_pending then 1 else 0 end), (.renewal_after // 0)
' 2>/dev/null) || { warn 'cannot read credentials for account %s' "$account"; return 1; }
fields=( "${(@f)metadata}" )
account_grant=$grant
zmodload zsh/datetime || return
if (( fields[5] && fields[5] <= EPOCHSECONDS && ! ${postcard_account_allow_expired:-0} )); then
    warn 'grant expired; run postcard --account %s login --client-id %s' "${(q)account}" "${(q)fields[1]}"; return 1
fi

